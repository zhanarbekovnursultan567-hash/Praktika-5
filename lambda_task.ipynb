    "def lambda_handler(event, context):\n",
    "    name = event.get(\"name\", \"Student\")\n",
    "    return {\n",
    "        \"statusCode\": 200,\n",
    "        \"body\": f\"Hello, {name}! Код сәтті орындалды.\"\n",
